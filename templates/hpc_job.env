# =============================================================================
# hpc_job.env: HPC job settings for ONE experiment
# =============================================================================
# Put this file in your EXPERIMENT folder, next to config.yaml:
#
#     exp_033/
#     ├── config.yaml
#     ├── hpc_job.env      <-- this file
#     ├── zmax_stain1/ ...
#
# Then submit from that folder. The job finds this file through the folder you
# submitted from, so the .lsf files themselves never need editing:
#
#     cd /data/Warmflash/KR/exp_033
#     bsub < /data/Warmflash/KR/micropattern_pipeline/hpc/run_pipeline_2dseg.lsf
#
# That one line runs everything: the segmentation job starts the analysis job
# itself when it finishes (THEN_ANALYSIS below). Re-running a part of it:
#     bash /data/Warmflash/KR/micropattern_pipeline/hpc/run.sh help
#
# The GUI writes this file for you (step "HPC job"). To edit by hand: change the
# values after '='. No spaces around '='. Leave a value empty ("") for the default.
# Lines starting with '#' are comments.
# =============================================================================

# --- Where things live ON THE HPC (not on your laptop) ----------------------
# The pipeline code (the folder holding main.py).
PIPELINE_DIR="/data/Warmflash/KR/micropattern_pipeline"
# The Python environment. Every job checks it first (a few seconds) and installs
# only what is missing or broken; the first job builds it.
VENV_DIR="/scratch/$USER/micropattern_venv"
# The experiment config, relative to this folder.
CONFIG="config.yaml"

# --- Segmentation jobs (run_pipeline_2dseg.lsf / run_pipeline_3dseg.lsf) -----
# Steps to run, in order. Any of: load segment extract
SEG_STEPS="load segment extract"
# Which datasets (names from config.yaml) each job processes. Empty = all.
# In an experiment with both MIP and z-stack folders, list the MIP datasets
# under 2D and the z-stack datasets under 3D.
DATASETS_2D=""
DATASETS_3D=""

# --- Which images (both job types) ------------------------------------------
# Empty = every image. Seq numbers as written in the filename (Seq0042 -> 42),
# e.g. "0-9 15 20-24". Wells e.g. "1-3" or "C1-C4". Both given = must match both.
# Overrides input.select in config.yaml.
SEQ=""
WELLS=""

# --- Recompute instead of resuming ------------------------------------------
# Finished images are skipped on re-submission. To redo work:
FORCE="false"                   # true = redo every selected step
SEG_FORCE_STEPS=""              # e.g. "segment extract"

# When segmentation finishes successfully, submit the analysis job by itself.
# With both a 2-D and a 3-D job, the one that finishes last does it.
THEN_ANALYSIS="true"

# --- Downstream job (run_downstream.lsf, CPU only) ---------------------------
RUN_CHECK="true"                # validate config + plate maps first; stop on errors
DOWNSTREAM_SEG_MODE=""          # empty = downstream.seg_mode in config.yaml; or 2d / 3d / auto
RUN_MANIFEST="true"             # (re)build the well/condition manifest
DOWNSTREAM_DATASETS=""          # empty = all
DOWNSTREAM_STEPS=""             # empty = all, e.g. "assemble qc thresholds"
DOWNSTREAM_FORCE="false"
DOWNSTREAM_FORCE_STEPS=""       # e.g. "thresholds"
DOWNSTREAM_OUT=""               # empty = downstream.results_dir from config.yaml (auto: analysis_2d / _3d)

# --- Cluster environment (change only if the HPC modules change) ------------
PYTHON_MODULE="python3/3.10.7"
# cuda/12.8 + cu128 PyTorch wheels are needed for the Blackwell (sm_120) GPUs on
# gpu-b6000. Do NOT drop to cu126/cu121: those wheels install but cannot use them.
CUDA_MODULE="cuda/12.8"
TORCH_INDEX="https://download.pytorch.org/whl/cu128"
# true = delete the Python environment and build it again before this job (slow;
# for when it is broken in a way the automatic check does not repair).
FRESH_VENV="false"
LOG_LEVEL="INFO"                # DEBUG for more detail
